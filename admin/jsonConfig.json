{
  "i18n": true,
  "type": "panel",
  "items": {
    "_intro": {
      "type": "staticText",
      "text": "introText",
      "xs": 12,
      "sm": 12,
      "md": 12,
      "lg": 12,
      "xl": 12
    },
    "_discover": {
      "type": "sendTo",
      "command": "discover",
      "label": "discoverBtn",
      "variant": "contained",
      "color": "primary",
      "useNative": true,
      "showProcess": true,
      "xs": 12,
      "sm": 12,
      "md": 6,
      "lg": 4,
      "xl": 4
    },
    "devices": {
      "type": "table",
      "label": "devicesTable",
      "uniqueColumns": ["ip"],
      "xs": 12,
      "sm": 12,
      "md": 12,
      "lg": 12,
      "xl": 12,
      "items": [
        { "type": "text", "attr": "name", "title": "columnName", "width": "50%" },
        { "type": "text", "attr": "ip", "title": "columnIp", "width": "50%" }
      ]
    }
  }
}
