{
  "name": "iobroker.yamaha",
  "version": "2.3.3",
  "description": "ioBroker adapter for Yamaha AV receivers and MusicCast devices",
  "author": {
    "name": "krobi",
    "email": "krobi@power-dreams.com"
  },
  "contributors": [
    {
      "name": "soef",
      "email": "soef@gmx.net",
      "role": "Original author"
    },
    {
      "name": "Garfonso",
      "email": "garfonso@mobo.info",
      "role": "Contributor"
    },
    {
      "name": "Sneak-L8",
      "email": "git@sengler.de",
      "role": "Contributor"
    },
    {
      "name": "iobroker-community-adapters",
      "email": "iobroker-community-adapters@gmx.de",
      "role": "Maintenance"
    },
    {
      "name": "Claude (Anthropic)",
      "role": "Coding assistance"
    }
  ],
  "homepage": "https://github.com/iobroker-community-adapters/ioBroker.yamaha",
  "license": "MIT",
  "keywords": [
    "ioBroker",
    "yamaha",
    "receiver",
    "RX-V",
    "MusicCast",
    "AVR",
    "home automation"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/iobroker-community-adapters/ioBroker.yamaha"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@iobroker/adapter-core": "^3.4.3",
    "@iobroker/dm-utils": "^3.2.0"
  },
  "devDependencies": {
    "@alcalzone/release-script": "^5.2.1",
    "@alcalzone/release-script-plugin-iobroker": "^5.2.0",
    "@alcalzone/release-script-plugin-license": "^5.2.2",
    "@iobroker/adapter-dev": "^1.5.0",
    "@iobroker/eslint-config": "^2.3.4",
    "@iobroker/testing": "^5.3.0",
    "@tsconfig/node22": "^22.0.5",
    "@types/iobroker": "npm:@iobroker/types@^7.2.2",
    "@types/node": "^22",
    "@vitest/coverage-v8": "^5.0.0",
    "iobroker-adapter-checks": "^0.3.0",
    "rimraf": "^6.1.3",
    "typescript": "~6.0.3",
    "vitest": "^5.0.0"
  },
  "main": "build/main.js",
  "files": [
    "build/",
    "admin/",
    "io-package.json",
    "LICENSE"
  ],
  "scripts": {
    "prebuild": "rimraf build",
    "build": "build-adapter ts",
    "watch": "build-adapter ts --watch",
    "check": "tsc --noEmit",
    "test:ts": "vitest run",
    "test:unit": "vitest run",
    "test:package": "mocha test/package --exit",
    "test:integration": "mocha test/integration --exit",
    "test": "npm run test:ts && npm run test:package && npm run test:integration",
    "coverage": "vitest run --coverage",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "format": "prettier --write . \"!build/**\" \"!io-package.json\" \"!.github/**\"",
    "format:check": "prettier --check . \"!build/**\" \"!io-package.json\" \"!.github/**\"",
    "release": "release-script",
    "translate": "translate-adapter"
  },
  "bugs": {
    "url": "https://github.com/iobroker-community-adapters/ioBroker.yamaha/issues"
  },
  "readmeFilename": "README.md",
  "overrides": {
    "mocha": {
      "diff": "^8.0.3",
      "serialize-javascript": "^7.0.5"
    },
    "@alcalzone/esbuild-register": {
      "esbuild": "^0.28.0"
    }
  }
}
